  "serviceRole": "arn:aws:iam::388482955098:role/velvet-elves-casa-codebuild-role",
  "timeoutInMinutes": 360,
  "queuedTimeoutInMinutes": 30,
  "logsConfig": {
    "cloudWatchLogs": {
      "status": "ENABLED",
      "groupName": "/aws/codebuild/velvet-elves-casa-zap-dast"
